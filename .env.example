# Required: server-side key for the Claude API (used by /api/plan and /api/logistics)
ANTHROPIC_API_KEY=sk-ant-...

# Required for the /execute map: Google Maps JavaScript API key.
# NEXT_PUBLIC_ = bundled into the browser by design; restrict the key by
# HTTP referrer (your domains) in Google Cloud Console. Enable BOTH
# "Maps JavaScript API" and "Geocoding API" on the key (places are geocoded
# on the fly in the browser, cached in localStorage). Restart the dev server
# after setting it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: Notion export (/api/export).
# 1. Create an internal integration at https://www.notion.so/my-integrations
# 2. Open the Notion page that should hold exported trips, Share → invite the integration
# 3. Put that page's id (the 32-hex tail of its URL) below
# Tip: publish that parent page to the web once — every exported trip page
# under it is then publicly viewable via its link (the API itself cannot
# toggle "Publish to web").
NOTION_API_KEY=ntn_...
NOTION_PARENT_PAGE_ID=
